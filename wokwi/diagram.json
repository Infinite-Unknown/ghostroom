{
  "version": 1,
  "author": "GhostRoom",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pir-motion-sensor", "id": "pir", "top": -120, "left": 150, "attrs": {} },
    { "type": "wokwi-led", "id": "led", "top": 200, "left": 200, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 270, "left": 150, "attrs": { "value": "220" } }
